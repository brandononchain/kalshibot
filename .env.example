# Kalshi API
KALSHI_API_KEY=your_api_key_here
KALSHI_PRIVATE_KEY_PATH=./kalshi_private_key.pem

# Market Selection
SERIES_TICKER=KXBTC15M           # Series ticker (KXBTC15M for 15-min)
SLOT_DURATION=900                # Slot duration in seconds (900=15min)

# Strategy Thresholds
MIN_EDGE=5.0                     # Minimum edge % for Polymarket arbitrage
MIN_DIVERGENCE=8.0               # Minimum divergence % for directional (Binance spot) trades
TRADING_WINDOW=10                # Only trade first N minutes of each 15-min market

# Position Sizing
MAX_POSITION_SIZE=25             # Maximum $ per trade (legacy sizing only)
MAX_TOTAL_OPEN_POSITIONS=10      # Maximum concurrent positions (legacy)
MAX_POSITIONS_PER_CONTRACT=2     # Maximum positions on same contract (legacy)
USE_KELLY_SIZING=true            # Enable Kelly criterion sizing (legacy; off under TradeCafe)
KELLY_FRACTION=0.25              # Kelly fraction (0.25 = quarter Kelly, conservative)

# ── TradeCafe discipline (recommended; default ON) ──
# Capital reserve, fixed-fractional sizing, probability calibration, macro gate,
# trailing profit-lock exit, and a portfolio drawdown kill-switch.
USE_TRADECAFE=true               # Master switch (set false to revert to legacy Kelly)
WORKING_CAPITAL_FRACTION=0.70    # Deploy only 70% of balance; keep 30% in reserve
ENTRY_FRACTION=0.02              # Each entry = 2% of working capital (fixed-fractional)
MAX_POSITION_FRACTION=0.06       # One ticker/side caps at 6% of working after averaging
CALIBRATION_SHRINK=0.88          # Shrink model prob toward 0.5 (fixes overconfidence)
TREND_GATE_STRENGTH=0.60         # Block counter-trend entries when trend strength >= this
AVERAGE_MAX_ADDS=2               # Allow up to 2 averaging adds at a better level
TRAIL_ARM_FRACTION=0.35          # Arm trailing stop after capturing 35% of max gain
TRAIL_GAP=0.04                   # Trail the contract bid 4c below its peak
HARD_TAKE_FRACTION=0.85          # Hard take-profit at 85% of max gain (dodge settle fee)
DRAWDOWN_KILL=0.30               # Flatten all + halt if equity falls 30% from peak
MAX_CONCURRENT=5                 # Max simultaneous positions (profit-locked frees a slot)

# Supabase (for ML pipeline + Vercel deployment)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_key_here

# Vercel Cron (auto-set by Vercel)
CRON_SECRET=your_cron_secret_here

# For Vercel: encode private key as base64 instead of file path
# KALSHI_PRIVATE_KEY_BASE64=base64_encoded_pem_contents

# Server
PORT=3333                        # Mission Control dashboard port
